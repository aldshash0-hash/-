rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signed() { return request.auth != null && request.auth.token.email_verified == true; }
    // المدير = حساب أدخل «رمز المدير» الصحيح (يُمنح تصريحًا مؤقتًا لمدة 8 ساعات من الخادم)
    function admin() {
      return signed() && request.auth.token.admin == true && request.auth.token.until > request.time.toMillis();
    }

    match /users/{uid} {
      allow read: if signed() && (request.auth.uid == uid || admin());
      allow create, update: if signed() && request.auth.uid == uid;
    }
    match /courses/{cid} {
      allow read: if signed();
      allow write: if admin();
      match /lessons/{lid} {
        allow read: if admin() || (signed() && (resource.data.free == true ||
          exists(/databases/$(database)/documents/enrollments/$(request.auth.uid + "_" + cid))));
        allow write: if admin();
      }
      match /answers/{lid} { allow read, write: if admin(); }
    }
    match /enrollments/{id} {
      allow read: if signed() && (resource.data.uid == request.auth.uid || admin());
      allow write: if admin();
    }
    match /payments/{id} {
      allow read: if signed() && (resource.data.uid == request.auth.uid || admin());
      allow create: if signed() && request.resource.data.uid == request.auth.uid && request.resource.data.status == "PENDING"
        && request.resource.data.amount == get(/databases/$(database)/documents/courses/$(request.resource.data.courseId)).data.price;
      allow update: if admin();
    }
    match /scores/{id} {
      allow read: if signed() && (resource.data.uid == request.auth.uid || admin());
      allow write: if false;
    }
  }
}
